# Copy this file to .env and fill in your Firebase project's web config
# (Firebase console -> Project settings -> General -> Your apps -> SDK setup and config).
# These EXPO_PUBLIC_ variables are inlined into the client bundle at build time,
# which is expected for Firebase web config — access is controlled by Firestore
# security rules, not by hiding these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud Console -> APIs & Services -> Credentials).
# expo-auth-session needs a "Web application" client ID, plus platform-specific ones
# once you build with EAS (see README for setup steps).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
